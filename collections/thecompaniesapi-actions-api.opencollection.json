              },
              {
                "name": "ids",
                "value": "",
                "type": "query"
              },
              {
                "name": "listId",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query"
              },
              {
                "name": "size",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "teamId",
                "value": "",
                "type": "query"
              },
              {
                "name": "type",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Get and filter your actions."
        },
        {
          "info": {
            "name": "requestAction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.thecompaniesapi.com/v2/actions",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Request or estimate a new action."
        },
        {
          "info": {
            "name": "retryAction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.thecompaniesapi.com/v2/actions/:actionId/retry",
            "params": [
              {
                "name": "actionId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Ask for a retry of failed action."
        }
      ]
    }
  ],
  "bundled": true
}