{
  "opencollection": "1.0.0",
  "info": {
    "name": "The Companies actions API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "actions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "fetchActions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.thecompaniesapi.com/v2/actions",
            "params": [
              {
                "name": "full",
                "value": "",
